# MongoDB connection string (MongoDB Atlas recommended for Railway deploys)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nancare?retryWrites=true&w=majority

# Port (Railway sets this automatically, but a fallback is fine)
PORT=5000

# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://nancarehospital.com,https://www.nancarehospital.com
FRONTEND_URL=http://localhost:3000

# Secret key required in the "x-admin-key" header to manage doctors/departments/appointments
ADMIN_KEY=change-this-to-a-long-random-string
